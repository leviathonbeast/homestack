# Updates smartctl's drive database, which names each disk's SMART
# attributes (Homestack's disk pages). Run monthly by homestack-drivedb.timer.
# Installed by deploy/debian/agent/install.sh.

[Unit]
Description=Update smartctl's drive database
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/update-smart-drivedb
